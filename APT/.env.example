# Environment variables for Adaptive Practice Tool
# Copy this file to .env and fill in your values — never commit .env to git

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adaptive_practice_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Connection Pool ---
# With N workers, Postgres sees up to DB_POOL_MAX * WORKERS total connections.
# Keep DB_POOL_MAX * WORKERS well below your Postgres max_connections (default 100).
DB_POOL_MIN=2
DB_POOL_MAX=5

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Server (load balancing) ---
PORT=5000
# WORKERS=1 → single-process dev mode with auto-reload
# WORKERS=4 → 4 independent async processes for production (use gunicorn.conf.py)
WORKERS=1

# --- Logging ---
LOG_LEVEL=info
